<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Routing Machine</title>
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />

    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css"
    />
    <style>
      body,
      html {
        padding: 0;
        margin: 0;
      }
      #map {
        height: 100vh; /* full viewport height */
        width: 100%; /* full width */
      }
    </style>
  </head>
  <div id="map"></div>

  <body>
    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""
    ></script>

    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>

    <script>
            // Baser layers
            let googleStreets = L.tileLayer(
              "http://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}",
              {
                maxZoom: 20,
                subdomains: ["mt0", "mt1", "mt2", "mt3"],
              }
            );
            let googleHybrid = L.tileLayer(
              "http://{s}.google.com/vt/lyrs=s,h&x={x}&y={y}&z={z}",
              {
                maxZoom: 20,
                subdomains: ["mt0", "mt1", "mt2", "mt3"],
              }
            );
            let googleSat = L.tileLayer(
              "http://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
              {
                maxZoom: 20,
                subdomains: ["mt0", "mt1", "mt2", "mt3"],
              }
            );

            let googleTerrain = L.tileLayer(
              "http://{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}",
              {
                maxZoom: 20,
                subdomains: ["mt0", "mt1", "mt2", "mt3"],
              }
            );
            var CartoDB_DarkMatter = L.tileLayer(
              "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
              {
                attribution:
                  '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
                subdomains: "abcd",
                maxZoom: 20,
              }
            );

            var OpenStreetMap_HOT = L.tileLayer(
              "https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png",
              {
                maxZoom: 19,
                attribution:
                  '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, Tiles style by <a href="https://www.hotosm.org/" target="_blank">Humanitarian OpenStreetMap Team</a> hosted by <a href="https://openstreetmap.fr/" target="_blank">OpenStreetMap France</a>',
              }
            );
            var OpenStreetMap_France = L.tileLayer(
              "https://{s}.tile.openstreetmap.fr/osmfr/{z}/{x}/{y}.png",
              {
                maxZoom: 20,
                attribution:
                  '&copy; OpenStreetMap France | &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
              }
            );
            // Baser layers

            var baseMaps = {
              googleStreets,
              googleHybrid,
              googleSat,
              googleTerrain,

              OpenStreetMap_France,
              OpenStreetMap_HOT,
              CartoDB_DarkMatter,
            };

            var map = L.map("map", {
              center: [28.8386, 78.7733],
              zoom: 16, // or 17–18 for detailed view,
              layers: [googleTerrain], // default layer
            });

            L.control.layers(baseMaps).addTo(map);

            // let's do it now
            const coordinates = <%- JSON.stringify(coordinates) %>;
            const     iconUrl = <%- JSON.stringify(iconUrl) %>;
            
            if(coordinates.length>1){



                                                                               const BusIcon = L.Icon.extend({
                                                       options: {
                                                         iconSize: [60, 45],
                                                         iconAnchor: [19, 45],
                                                         popupAnchor: [0, -40]
                                                       }
                                                     });



      var busMarker;
              L.Routing.control({
              waypoints: coordinates,
            })
              .addTo(map)
              .on("routesfound", function (e) {
                e.routes[0].coordinates.forEach((element, index) => {

                  if(index==0){
                      const busIcon = new BusIcon({ iconUrl: iconUrl });
                      busMarker = L.marker([element.lat,element.lng], { icon: busIcon }).addTo(map)
                    }else{
                      setTimeout(() => {

              busMarker.setLatLng([element.lat, element.lng]);

            }, 100 * index);
                    }

                });
              });

            }
    </script>
  </body>
</html>
