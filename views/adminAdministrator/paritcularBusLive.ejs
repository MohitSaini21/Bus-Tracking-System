    <script src="/socket.io/socket.io.js"></script>
    <!-- End custom js for this page -->
    <!-- custome scirpt to hanlde the lat and lingoit got it  -->
    <script>

                               const bus = <%- JSON.stringify(bus) %>;

                          const socket = io({
                                              query: {                                  adminId:"122345",
                                                                                            bus: bus._id.toString() // Convert the _id to a string (if it’s a MongoDB ObjectId)
                                                                                          }
                                                                                        });
      socket.emit("distanceTravelled", bus._id, (distance) => {
        if (distance) {
          // Get previous values
          const prevMeters = parseFloat(document.getElementById("distanceTravelledMeter").textContent) || 0;
          const prevKm = parseFloat(document.getElementById("distanceTravelledkm").textContent) || 0;

          // Add the new distance
          const newMeters = prevMeters + distance;
          const newKm = prevKm + distance / 1000;

          // Update UI
          document.getElementById("distanceTravelledMeter").textContent = `${Math.round(newMeters)}`;
          document.getElementById("distanceTravelledkm").textContent = `${newKm.toFixed(2)}`;
        } else {
          console.log("distance is zero");
        }
      });



      socket.on("distanceCovered", (data) => {
        let distance = data.totalDistance;

        // Get current span values (or 0 if empty)
        const prevMeters = parseFloat(document.getElementById("distanceTravelledMeter").textContent) || 0;
        const prevKm = parseFloat(document.getElementById("distanceTravelledkm").textContent) || 0;

        // Add new distance
        const newMeters = prevMeters + distance;
        const newKm = prevKm + distance / 1000;

        // Update UI
        document.getElementById("distanceTravelledMeter").textContent = `${Math.round(newMeters)}`;
        document.getElementById("distanceTravelledkm").textContent = `${newKm.toFixed(2)}`;
      });
    </script>
