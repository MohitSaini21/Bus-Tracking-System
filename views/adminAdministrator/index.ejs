<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>Corona Admin</title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="/assets/loader.css" />
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <link
      rel="stylesheet"
      href="/assets/vendors/jvectormap/jquery-jvectormap.css"
    />
    <link
      rel="stylesheet"
      href="/assets/vendors/flag-icon-css/css/flag-icon.min.css"
    />
    <link
      rel="stylesheet"
      href="/assets/vendors/owl-carousel-2/owl.carousel.min.css"
    />
    <link
      rel="stylesheet"
      href="/assets/vendors/owl-carousel-2/owl.theme.default.min.css"
    />
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />
    <!-- End layout styles -->
    <link rel="shortcut icon" href="/assets/images/favicon.png" />
    <style>
      .vehicle-moving {
        animation: drive 2s linear infinite;
        display: inline-block;
      }

      @keyframes drive {
        0% {
          transform: translateX(0);
        }
        50% {
          transform: translateX(5px);
        }
        100% {
          transform: translateX(0);
        }
      }
    </style>
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:partials/_sidebar.html -->

      <%- include('../corePartials/sidebar.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_navbar.html -->

        <%- include('../corePartials/nav.ejs') %>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="row">
              <div class="col-sm-4 grid-margin">
                <div class="card">
                  <div class="card-body">
                    <h5>
                      <a href="/admin/garrage" style="text-decoration: none"
                        >Total Vehicles Registered</a
                      >
                    </h5>
                    <div class="row">
                      <div class="col-8 col-sm-12 col-xl-8 my-auto">
                        <div
                          class="d-flex d-sm-block d-md-flex align-items-center"
                        >
                          <h2 class="mb-0">30</h2>
                        </div>
                      </div>
                      <div
                        class="col-4 col-sm-12 col-xl-4 text-center text-xl-right"
                      >
                        <i
                          class="icon-lg mdi mdi-jeepney ml-auto vehicle-moving"
                          style="color: #ffc107"
                        ></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-sm-4 grid-margin">
                <div class="card">
                  <div class="card-body">
                    <h5>
                      <a
                        href="/admin/garrage?search=Out+of+Service"
                        style="text-decoration: none"
                        >Out Of Service Vehicles</a
                      >
                    </h5>

                    <div class="row">
                      <div class="col-8 col-sm-12 col-xl-8 my-auto">
                        <div
                          class="d-flex d-sm-block d-md-flex align-items-center"
                        >
                          <h2 class="mb-0">23</h2>
                        </div>
                      </div>
                      <div
                        class="col-4 col-sm-12 col-xl-4 text-center text-xl-right"
                      >
                        <i
                          class="icon-lg mdi mdi-jeepney text-danger ml-auto vehicle-moving"
                        ></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-sm-4 grid-margin">
                <div class="card">
                  <div class="card-body">
                    <h5>
                      <a
                        href="/admin/garrage?search=Operational"
                        style="text-decoration: none"
                        >Operational Vehicles</a
                      >
                    </h5>
                    <div class="row">
                      <div class="col-8 col-sm-12 col-xl-8 my-auto">
                        <div
                          class="d-flex d-sm-block d-md-flex align-items-center"
                        >
                          <h2 class="mb-0">20</h2>
                        </div>
                      </div>
                      <div
                        class="col-4 col-sm-12 col-xl-4 text-center text-xl-right"
                      >
                        <i
                          class="icon-lg mdi mdi-jeepney text-success ml-auto vehicle-moving"
                        ></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <% if (user.role=="administrator") { %>

              <div class="col-sm-4 grid-margin">
                <div class="card">
                  <div class="card-body">
                    <h5>
                      <a
                        href="/tmu/administrator/settings/addAdmin"
                        style="text-decoration: none"
                        >Total Admins</a
                      >
                    </h5>
                    <div class="row">
                      <div class="col-8 col-sm-12 col-xl-8 my-auto">
                        <div
                          class="d-flex d-sm-block d-md-flex align-items-center"
                        >
                          <h2 class="mb-0">4</h2>
                        </div>
                      </div>
                      <div
                        class="col-4 col-sm-12 col-xl-4 text-center text-xl-right"
                      >
                        <i
                          class="icon-lg mdi mdi-account-multiple-plus text-success ml-auto"
                        ></i>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <% } %>
            </div>
          </div>
          <!-- content-wrapper ends -->
          <!-- partial:partials/_footer.html -->
          <!-- <%- include('../corePartials/footer.ejs') %> --
         
        partial -->

          <%-include('../corePartials/loader.ejs') %>
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="/assets/vendors/chart.js/Chart.min.js"></script>
    <script src="/assets/vendors/progressbar.js/progressbar.min.js"></script>
    <script src="/assets/vendors/jvectormap/jquery-jvectormap.min.js"></script>
    <script src="/assets/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
    <script src="/assets/vendors/owl-carousel-2/owl.carousel.min.js"></script>
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/todolist.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="/assets/js/dashboard.js"></script>
    <script type="module" src="/firebase.js"></script>
    <script type="module" src="/foreground.js"></script>

    <!-- End custom js for this page -->
    <!-- custom Script -->

    <script type="module">
      import { fetchToken } from "/firebase.js";

      const fcmToken = localStorage.getItem("fcmToken");
      const expiryDateStr = localStorage.getItem("fcmTokenExpiryDate");

      let isTokenValid = false;

      if (fcmToken && expiryDateStr) {
        const now = new Date();
        const expiryDate = new Date(expiryDateStr);

        if (now < expiryDate) {
          isTokenValid = true;
        }
      }

      if (!fcmToken || !isTokenValid) {
        fetchToken();
      } else {
      }

      window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };
    </script>

    <!-- custom Script -->
  </body>
</html>
