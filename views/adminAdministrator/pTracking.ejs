<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>Corona Admin</title>
    <!-- plugins:css -->
    <link
      rel="stylesheet"
      href="/assets/vendors/mdi/css/materialdesignicons.min.css"
    />
    <link rel="stylesheet" href="/assets/vendors/css/vendor.bundle.base.css" />
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <link
      rel="stylesheet"
      href="/assets/vendors/jvectormap/jquery-jvectormap.css"
    />
    <link
      rel="stylesheet"
      href="/assets/vendors/flag-icon-css/css/flag-icon.min.css"
    />
    <link
      rel="stylesheet"
      href="/assets/vendors/owl-carousel-2/owl.carousel.min.css"
    />

    <link rel="stylesheet" href="/assets/loader.css" />

    <link
      rel="stylesheet"
      href="/assets/vendors/owl-carousel-2/owl.theme.default.min.css"
    />

    <!-- You can add this inside your page CSS or <style> -->
    <style>
      .row-updated {
        animation: blinkRow 0.3s ease-in-out 2;
        background-color: #fff8dc !important; /* Light yellow highlight */
      }

      @keyframes blinkRow {
        0% {
          background-color: #fff8dc;
        }
        50% {
          background-color: #fff4b2;
        }
        100% {
          background-color: #fff8dc;
        }
      }
    </style>

    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="/assets/css/style.css" />
    <!-- End layout styles -->
    <link rel="shortcut icon" href="/assets/images/favicon.png" />
  </head>
  <body>
    <div class="container-scroller">
      <!-- partial:partials/_sidebar.html -->

      <%- include('../corePartials/sidebar.ejs') %>
      <!-- partial -->
      <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_navbar.html -->

        <%- include('../corePartials/nav.ejs') %>
        <!-- partial -->
        <div class="main-panel">
          <div class="content-wrapper">
            <h3 class="h4 border-bottom pb-2 mb-3">
              Bus No:
              <span class="text-white"
                ><a href="/admin/CDB/<%=bus._id  %>"
                  ><%=bus.busNumber %></a
                ></span
              >
            </h3>

            <p class="mb-2">
              <strong>Driver:</strong> <%=bus.driver.name %>
              <span class="text-muted">(<%=bus.driver.phone %>)</span>
            </p>

            <p class="mb-0">
              <strong>Conductor:</strong> <%=bus.conductor.name %>
              <span class="text-muted">(<%=bus.conductor.phone %>)</span>
            </p>

            <br />

            <div class="row m-0 p-0">
              <div class="col-12 m-0 p-0">
                <div class="card m-0 p-1">
                  <div class="card-body m-0 p-1">
                    <div class="row">
                      <div class="col-md-5">
                        <iframe
                          src="/locationBus/<%=bus._id  %>"
                          style="
                            height: 300px;
                            width: 100%;
                            border: none;
                            display: block;
                          "
                        ></iframe>
                      </div>
                      <div class="col-md-7">
                        <% if (user.role === "administrator") { %>
                        <iframe
                          src="/administrator/settings/liveStream/<%=bus._id  %>"
                          style="
                            height: 300px;
                            width: 100%;
                            border: none;
                            display: block;
                          "
                        ></iframe>
                        <% } else { %>
                        <div
                          class="d-flex justify-content-center align-items-center"
                          style="height: 300px"
                        >
                          <p class="text-muted h5 mb-0">
                            You Can not Enjoy live Camera View Vehchiles
                          </p>
                        </div>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <br />
            <div class="row">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Stops Covered</h4>

                    <div class="table-responsive">
                      <table
                        class="table table-bordered text-center"
                        id="stops-covered"
                      >
                        <thead class="thead-dark">
                          <tr>
                            <th>#</th>

                            <th>Stop Name</th>
                            <th>Morning</th>
                            <th>Evening</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (busLog && busLog.stops && busLog.stops.length > 0) { %>
                            <% busLog.stops.forEach((stopLog, index) => { %>
                              <tr id="<%= stopLog.stop._id %>">
                                <td><%= index + 1 %></td>
                                <td><%= stopLog.stopName || '__' %></td>
                        
                                <!-- Morning Times -->
                                <td>
                                  <div>
                                    <div>
                                      <strong>Expected:</strong>
                                      <%= stopLog.eMorningTime
                                        ? moment(new Date(stopLog.eMorningTime)).tz('Asia/Kolkata').format('hh:mm A')
                                        : '__' %>
                                    </div>
                                    <div>
                                      <strong>Actual:</strong>
                                      <%= stopLog.morningTime
                                        ? moment(new Date(stopLog.morning)).tz('Asia/Kolkata').format('hh:mm A')
                                        : '__' %>
                                    </div>
                                  </td>
                                  
                                </td>
                        
                                <!-- Evening Times -->
                                <td>
                                  <div>
                                    <strong>Expected:</strong>
                                    <%= stopLog.eEveningTime
                                      ? moment(new Date(stopLog.eEveningTime)).tz('Asia/Kolkata').format('hh:mm A')
                                      : '__' %>
                                  </div>
                                  <div>
                                    <strong>Actual:</strong>
                                    <%= stopLog.eveningTime
                                      ? moment(new Date(stopLog.eveningTime)).tz('Asia/Kolkata').format('hh:mm A')
                                      : '__' %>
                                  </div>
                                </td>
                                
                                
                              </tr>
                            <% }) %>
                          <% } %>
                        </tbody>
                        
                      </table>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Stops Covered</h4>

                    <div class="table-responsive mt-4">
                      <h5 class="text-center mb-3">Polygon Events</h5>
                      <table class="table table-bordered text-center">
                        <thead class="thead-dark">
                          <tr>
                            <th>#</th>
                            <th>campus</th>
                            <th>Event Type</th>
                            <th>Timestamp</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (busLog && busLog.events && busLog.events.length
                          > 0) { %> <% busLog.events.forEach((ev, index) => { %>
                          <tr>
                            <td><%= index + 1 %></td>
                                 <td><%=ev.campus %></td>
                            <td>
                              <span
                                class="badge <%= ev.event === 'Entered' ? 'bg-success' : 'bg-danger' %>"
                              >
                                <%= ev.event %>
                              </span>
                            </td>
                            <td>
                              <%= new Date(ev.timestamp).toLocaleString() %>
                            </td>
                       
                          </tr>
                          <% }) %> <% } else { %>
                          <tr>
                            <td colspan="4">No events recorded</td>
                          </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <br />
          </div>
          <!-- content-wrapper ends -->
          <!-- partial:partials/_footer.html -->
          <%- include('../corePartials/loader.ejs') %> <%-
          include('../corePartials/footer.ejs') %>

          <!-- partial -->
        </div>
        <!-- main-panel ends -->
      </div>
      <!-- page-body-wrapper ends -->
    </div>
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="/assets/vendors/chart.js/Chart.min.js"></script>
    <script src="/assets/vendors/progressbar.js/progressbar.min.js"></script>
    <script src="/assets/vendors/jvectormap/jquery-jvectormap.min.js"></script>
    <script src="/assets/vendors/jvectormap/jquery-jvectormap-world-mill-en.js"></script>
    <script src="/assets/vendors/owl-carousel-2/owl.carousel.min.js"></script>
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="/assets/js/off-canvas.js"></script>
    <script src="/assets/js/hoverable-collapse.js"></script>
    <script src="/assets/js/misc.js"></script>
    <script src="/assets/js/settings.js"></script>
    <script src="/assets/js/todolist.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <!-- endinject -->
    <!-- Custom js for this page -->

    <!-- custom Script  -->

    <script>
                                    const user= <%- JSON.stringify(user) %>;
                                    const bus= <%- JSON.stringify(bus) %>;
                              const socket = io({
                                query: {
                                  adminId: user._id,
                                  bus: bus._id
                                }
                              });

      // fucntiom to update the row

  function updateStopsCoveredTable(reachedStops) {
  const tbody = document.querySelector("#stops-covered tbody");
  if (!tbody) {
    console.error("❌ tbody not found inside #stops-covered");
    return;
  }

  console.log("✅ Received reachedStops:", reachedStops); // Debug

  Object.entries(reachedStops).forEach(([stopId, info], index) => {
    const rowId = String(stopId);
    const existingRow = document.getElementById(rowId);

    const stopName = info.stopName || "Unknown";

    // Safely parse time fields
    const eMorningTime = info.eMorningTime ? new Date(info.eMorningTime) : null;
    const morningTime = info.morningTime ? new Date(info.morningTime) : null;

    const eEveningTime = info.eEveningTime ? new Date(info.eEveningTime) : null;
    const eveningTime = info.eveningTime ? new Date(info.eveningTime) : null;

    const formatTime = (d) =>
      d instanceof Date && !isNaN(d)
        ? d.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' })
        : "__";

    // 🧪 Logging
    console.log(`📄 Rendering row for stop: ${stopName}`, {
      eMorningTime, morningTime, eEveningTime, eveningTime
    });

    // Build the row
    const newRow = document.createElement("tr");
    newRow.id = rowId;
    newRow.innerHTML = `
      <td></td>
      <td>${stopName}</td>
      <td>
        <div><strong>Expected:</strong> ${formatTime(eMorningTime)}</div>
        <div><strong>Actual:</strong> ${formatTime(morningTime)}</div>
      </td>
      <td>
        <div><strong>Expected:</strong> ${formatTime(eEveningTime)}</div>
        <div><strong>Actual:</strong> ${formatTime(eveningTime)}</div>
      </td>
    `;

    // Replace or insert
    if (existingRow) {
      tbody.replaceChild(newRow, existingRow);
    } else {
      tbody.appendChild(newRow);
    }

    // ✨ Blinking effect
    newRow.classList.add("row-updated");
    setTimeout(() => newRow.classList.remove("row-updated"), 3000);
  });

  // 🔢 Renumber all rows
  Array.from(tbody.querySelectorAll("tr")).forEach((row, i) => {
    const indexCell = row.querySelector("td:first-child");
    if (indexCell) indexCell.textContent = i + 1;
  });
}



      socket.emit("getObject", { busId: bus._id }, function (response) {
        if (response.data) {
          updateStopsCoveredTable(response.data.reachedStops);
        }
      });

      socket.on("busUpdate", function (data) {
        console.log(data);
        if (data && data.busObject) {
          updateStopsCoveredTable(data.busObject.reachedStops);
        }
      });

      window.onload = function () {
        document.getElementById("loader").style.display = "none";
      };
    </script>

    <!-- custom Script  -->
    <script src="/assets/js/dashboard.js"></script>
    <script type="module" src="/foreground.js"></script>
    <!-- End custom js for this page -->
  </body>
</html>
