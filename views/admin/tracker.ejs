></script>

<script src="https://unpkg.com/leaflet.marker.slideto/leaflet.marker.slideto.js"></script>



      <script src="/socket.io/socket.io.js"></script>
<script>

function append(id) {
  const mainRow = document.getElementById("mainRow");
  console.log(mainRow);
  const element = document.getElementById(id);
            
            // Removing the element from the DOM
            if (element) {
                element.remove();
            } 
            

  const col = `
    <div class="col-sm-4 grid-margin " id=${id}>
      <div class="card m-1">
        <div class="card-body  p-1">
  
          
          <iframe
            src="/tmu/admin/settings/liveStream/${id}"
            width="100%"
            height="200"
            allow="camera; microphone"
            style="border-radius: 8px; border: none;"
          ></iframe>
        </div>
      </div>
    </div>
  `;

  const tempDiv = document.createElement("div");
  tempDiv.innerHTML = col.trim();
  const newCol = tempDiv.firstChild;

mainRow.appendChild(newCol); // ✅ This appends it at the end

}

// append("67f5503b1adadc8c3c290007")

  
  const socket = io({
    query: {
     adminId: "1234567890"
    }
  });
 socket.on("deleteStream",(busId)=>{
    console.log(busId)
    console.log("Disconnectoin")
      const element = document.getElementById(busId);
            
            // Removing the element from the DOM
            if (element) {
                element.remove();
            } 
  })


  socket.on("newStream",(busid)=>{
    console.log("newConection")

    append(busid)
  })
 


  setTimeout(() => {
      socket.emit("allStream",(response)=>{

        
    response.forEach(element => {
      append(element)
    });

  })
  }, 5000);





  // Tile layers for Google and others
  var googleStreets = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleHybrid = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=s,h&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleSat = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleTerrain = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  // Initialize the map with a default layer
  var map = L.map("map", {
    center: [29.4426,78.4327],
    zoom: 30,
    layers: [googleTerrain] // default layer
  });


  
  // Define base maps
  var baseMaps = {
    "Google Streets": googleStreets,
    "Google Terrain": googleTerrain,
    "Google Satellite": googleSat,
    "Google Hybrid": googleHybrid
  };

  

  
  // Global layerGroup to hold all bus markers
const busLayerGroup = L.layerGroup().addTo(map);

// Also register it in layer control (optional but good)
const overlays = {
  "🚌 Active Buses": busLayerGroup
};
L.control.layers(baseMaps, overlays).addTo(map);

// Cache to track markers by busId
const markerCache = {};

const BusIcon = L.Icon.extend({
  options: {
    iconSize: [60, 45],
    iconAnchor: [19, 45],
    popupAnchor: [0, -40]
  }
});

socket.on("allBusLocations", (data) => {
  console.log(data)
  const busId = data.bus._id;
  const lat = data.latitude;
  const lng = data.longitude;

  const busIcon = new BusIcon({ iconUrl: data.bus.iconPhoto });

const popupHTML = `
  <style>
    .leaflet-popup-content {
      margin: 0 !important;
    }
    .bus-popup {
      font-family: Arial, sans-serif;
      max-width: 280px;
      padding: 10px;
    }
    .bus-title {
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 10px;
      color: #333;
    }
    .person-card {
      display: flex;
      align-items: center;
      margin-bottom: 10px;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 6px;
      background: #f9f9f9;
    }
    .person-card img {
      width: 45px;
      height: 45px;
      border-radius: 50%;
      object-fit: cover;
      margin-right: 10px;
    }
    .person-info {
      font-size: 13px;
    }
    .person-info b {
      display: block;
      color: #444;
    }
    .info-line {
      font-size: 13px;
      margin-top: 6px;
    }
    .info-line b {
      color: #444;
    }
.popup-footer {
  margin-top: 10px;
  text-align: center;
}

.track-btn {
  display: inline-block;
  background-color: #4CAF50;
  color: white;
  padding: 8px 16px;
  font-size: 14px;
  border-radius: 6px;
  cursor: pointer;
  text-decoration: none;
  margin-bottom: 10px;
}

.track-btn:hover {
  background-color: #45a049;
}

.call-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}

.call-btn {
  flex: 1 1 120px;
  background-color: #007bff;
  color: white;
  padding: 8px 10px;
  font-size: 14px;
  border-radius: 6px;
  text-decoration: none;
  text-align: center;
}

.call-btn:hover {
  background-color: #0056b3;
}

    .last-updated {
      font-size: 12px;
      color: #777;
      margin-top: 10px;
    }
  </style>

  <div class="bus-popup">
    <div class="bus-title">🚌 Bus No: ${data.bus.busNumber}</div>

    <div class="person-card">
      <img src="${data.bus.driver?.profilePhoto || 'default-driver.jpg'}" alt="Driver">
      <div class="person-info">
        <b>🧑‍✈️ Driver</b>
        ${data.bus.driver?.name || 'N/A'}<br>
        📞 ${data.bus.driver?.phone || 'N/A'}
      </div>
    </div>

    <div class="person-card">
      <img src="${data.bus.conductor?.profilePhoto || 'default-conductor.jpg'}" alt="Conductor">
      <div class="person-info">
        <b>👨‍💼 Conductor</b>
        ${data.bus.conductor?.name || 'N/A'}<br>
        📞 ${data.bus.conductor?.phone || 'N/A'}
      </div>
    </div>

    <div class="info-line"><b>🚏 Route:</b> ${data.bus.route || 'N/A'}</div>
    <div class="info-line"><b>⛽ Fuel Type:</b> ${data.bus.fuelType || 'N/A'}</div>
<div class="popup-footer">
  <a href="javascript:void(0);" class="track-btn" onclick="trackBus(${data.bus._id})">📍 Track This Bus</a>
  <div class="call-buttons">
    <a href="tel:${data.bus.driver?.phone || ''}" class="call-btn">📞 Call Driver</a>
    <a href="tel:${data.bus.conductor?.phone || ''}" class="call-btn">📞 Call Conductor</a>
  </div>
</div>

    <div class="last-updated">
      Last updated: ${new Date(data.timestamp).toLocaleString()}
    </div>
  </div>
`;



  if (markerCache[busId]) {
    // Update existing marker
    markerCache[busId].slideTo([lat, lng], {
    duration: 1000
  });
    markerCache[busId].setPopupContent(popupHTML);

    
  } else {
    // Create new marker and add to LayerGroup
    const marker = L.marker([lat, lng], { icon: busIcon })
      .bindPopup(popupHTML);

    markerCache[busId] = marker;
      // Add event listener for details panel
  marker.on("click", () => {
    showBusDetails(data.bus); // or just data.bus._id
  });
    busLayerGroup.addLayer(marker);
  }

  

});

function showBusDetails(data){
  console.log(data)

}









</script>








