      <script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io({
    query: {
      adminId: "1234567890"
    }
  });

  // Tile layers for Google and others
  var googleStreets = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=m&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleHybrid = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=s,h&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleSat = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  var googleTerrain = L.tileLayer(
    "http://{s}.google.com/vt/lyrs=p&x={x}&y={y}&z={z}",
    {
      maxZoom: 20,
      subdomains: ["mt0", "mt1", "mt2", "mt3"]
    }
  );

  // Initialize the map with a default layer
  var map = L.map("map", {
    center: [28.8347, 78.7763],
    zoom: 30,
    layers: [googleTerrain] // default layer
  });

  // Define base maps
  var baseMaps = {
    "Google Streets": googleStreets,
    "Google Terrain": googleTerrain,
    "Google Satellite": googleSat,
    "Google Hybrid": googleHybrid
  };

  var markerCache = {}; // Cache to store markers by busId

  // Define overlay maps
  var overlayMaps = {}; // Empty initially, will be filled dynamically

  // Variable to track the layer control instance
  let layerControlInstance = null;

  socket.on("allBusLocations", (data) => {
    console.log(data);
    const { busId, latitude, longitude } = data;

    // Check if the marker for this busId already exists
    if (markerCache[busId]) {
      // If the marker exists, update its position
      let existingMarker = markerCache[busId];
      existingMarker.setLatLng([latitude, longitude]); // Update position

      // Optionally, update the popup or other properties here
      existingMarker.bindPopup(`Bus ID: ${busId}<br>Location: ${latitude}, ${longitude}`).openPopup();
    } else {
      // If the marker doesn't exist, create a new one
      let newMarker = L.marker([latitude, longitude], {
        title: `Bus ID: ${busId}`,
      }).addTo(map);

      // Cache the marker by busId
      markerCache[busId] = newMarker;

      // Add the new marker to the overlayMaps with busId as the key
      overlayMaps[busId] = newMarker; // Add the marker to the overlay with busId as the key
    }

    // If a previous layer control exists, remove it
    if (layerControlInstance) {
      map.removeControl(layerControlInstance);
    }

    // Create a new layer control and add it to the map
    layerControlInstance = L.control.layers(baseMaps, overlayMaps).addTo(map);
  });

  // Initial layer control
  layerControlInstance = L.control.layers(baseMaps, overlayMaps).addTo(map);
</script>





