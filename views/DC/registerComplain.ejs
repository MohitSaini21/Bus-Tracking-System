<div class="col-md-6 grid-margin stretch-card">
  <div class="card">
    <div class="card-body">
      <h4 class="card-title">Register Complaint</h4>
      <p class="card-description">Use this form to register a complaint by uploading relevant files (image/video and audio explanation).</p>
      <form class="forms-sample" action="/DC/registerComplain" method="POST" enctype="multipart/form-data">
        
        <!-- Incident Image or Video Upload -->
        <div class="form-group">
          <label for="incidentMedia">Incident Image or Video</label>
          <input type="file" class="form-control" id="incidentMedia" name="media" accept="image/*, video/*" required>
        </div>

        <!-- Incident Audio Explanation Upload -->
        <div class="form-group">
          <label for="incidentAudio">Incident Audio Explanation</label>
          <input type="file" class="form-control" id="incidentAudio" name="audio" accept="audio/*" required>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary mr-2">Submit</button>
        <!-- Cancel Button -->
        <button type="button" class="btn btn-dark" onclick="window.location.href='/DC/registerComplain';">Cancel</button>
        
      </form>
    </div>
  </div>
