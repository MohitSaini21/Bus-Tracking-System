    <!-- custom Script -->

    <script type="module">
      import { fetchToken, sendTokenToServer } from "/wfirebase.js";

      // Helper: Check if a cookie exists
      function getCookie(name) {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(";").shift();
      }

      // 1. If cookie exists, do nothing (admin refreshed the page)
      if (getCookie("fcmTokenExpiry")) {
        console.log("Cookie exists — skipping token logic (page refresh).");
      } else {
        // 2. Check localStorage token validity
        const fcmToken = localStorage.getItem("fcmToken");
        const expiryDateStr = localStorage.getItem("fcmTokenExpiryDate");

        let isTokenValid = false;

        if (fcmToken && expiryDateStr) {
          const now = new Date();
          const expiryDate = new Date(expiryDateStr);
          if (now < expiryDate) {
            isTokenValid = true;
          }
        }

        if (!fcmToken || !isTokenValid) {
          fetchToken();
        } else {
          const expiryDate = new Date(expiryDateStr); // 🔥 Convert string to Date object
          sendTokenToServer(fcmToken, expiryDate);
        }
      }


      
    </script>

<script>

const user = <%- JSON.stringify(user) %>;
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("odometerForm");
    const input = document.getElementById("odometerReading");

    form.addEventListener("submit", async (e) => {
      e.preventDefault(); // ✅ prevents page refresh

      const reading = input.value;

      try {
        const response = await fetch("/DC/odometer", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ odometerReading: reading , busId : user.assignedBus._id }),
        });

        const result= await response.json()
        let  message = result.message.slice(2); // pehle ke 2 character (🔇) hata do
        safeSpeakHindi(message)
        alert(result.message)
     
      
      } catch (err) {
        console.error(err);
        alert("❌ Server or network error.");
        safeSpeakHindi("Server or network error.");
      }
    });
  });
</script>
 
<script>
    function handleEmergencyClick() {

      safeSpeakHindi("क्या आप वाकई आपातकालीन सूचना भेजना चाहते हैं ");
    const confirmEmergency = confirm("⚠️ क्या आप वाकई आपातकालीन सूचना भेजना चाहते हैं?");

    if (!confirmEmergency) {
      safeSpeakHindi("आपातकालीन कार्रवाई रद्द कर दी गई है।");
      alert("❌ आपातकालीन कार्रवाई रद्द कर दी गई है।");
      return;
    }

    // 📦 Optional: आप चाहें तो ड्राइवर/बस की जानकारी यहाँ जोड़ सकते हैं
    const emergencyData = {
      timestamp: new Date().toISOString(),

      busId:user.assignedBus._id
    };

    // 🚀 Server को सूचना भेजना
    fetch('/DC/emergencyAlert', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(emergencyData)
    })
    .then(response => {
      if (response.ok) {
        safeSpeakHindi("सूचना भेज दी गई है। प्रशासन जल्द ही संपर्क करेगा।");
        alert("✅ सूचना भेज दी गई है। प्रशासन जल्द ही संपर्क करेगा।");
     
        
      } else {

        
        throw new Error("सर्वर त्रुटि");
      }
    })
    .catch(error => {
      console.error("❌ नेटवर्क त्रुटि:", error);
      safeSpeakHindi("सूचना भेजने में समस्या आई। कृपया पुनः प्रयास करें।")
      alert("❌ सूचना भेजने में समस्या आई। कृपया पुनः प्रयास करें।");
    });
  }


  
        window.onload = function () {
          document.getElementById("loader").style.display = "none";
        };
</script>

