    <div class="container text-center">
      <div class="row">
        <div class="col-12 col-md-6 mb-3">
          <div id="map" style="height: 400px"></div>
        </div>
        <div class="col-12 col-md-6">
          <p>
            Lorem ipsum dolor sit, amet consectetur adipisicing elit. Aut
