<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT"
      crossorigin="anonymous"
    />

    <link rel="stylesheet" href="/assets/homeLoader.css" />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
      crossorigin="anonymous"
    ></script>
    <title>trackBus</title>
  </head>
  <body>
    <nav class="navbar bg-body-tertiary">
      <div class="container-fluid">
        <a class="navbar-brand" href="/"> Home </a>
      </div>
    </nav>

        <!-- Loader -->
        <div class="loader-overlay" id="loader">
          <div class="loader-container">
            <img src="/public/bus.gif" alt="Loading..." class="bus-icon-img" />
            <div class="loader-text" id="loader-text">Loading, please wait...</div>
          </div>
        </div>
    
    <div class="container">
      <br />
      <% data.forEach((entry) => { const createdAt = new Date(entry.createdAt);
      const expiryDate = new Date(createdAt);
      expiryDate.setDate(createdAt.getDate() + 30); %>
      <div class="card mb-3">
        <div class="card-header">Tracked Bus</div>
        <div class="card-body">
          <h5 class="card-title">
            Bus Number: <%= entry.busId.busNumber %> (<%= entry.busId.route %>)
          </h5>
          <p class="card-text">
            <strong> Stop:</strong> <%= entry.stop.stopName %>
            <strong> Morning Time:</strong> <%= entry.stop.morningTime %>
            <strong> Evening Time:</strong> <%= entry.stop.eveningTime %>
            <strong>Expiry Date:</strong> <%= new
            Date(entry.expireDate).toLocaleString() %><br />
          </p>
          <div class="d-flex gap-2">
            <button
              class="btn btn-sm btn-warning"
              onclick="toggleActive('<%= entry._id %>', <%= !entry.isActive %>, this)"
            >
              <%= entry.isActive ? "disabled" : "active" %>
            </button>

            <button
              class="btn btn-danger"
              onclick="deleteFCM('<%= entry._id %>',this)"
            >
              Delete
            </button>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.min.js"
      integrity="sha384-RuyvpeZCxMJCqVUGFI0Do1mQrods/hhxYlcVfGPOfQtPJh0JCw12tUAZ/Mv10S7D"
      crossorigin="anonymous"
    ></script>

    <script>
      function toggleActive(id, status, buttonElement) {
        const originalText = buttonElement.textContent;
        buttonElement.textContent = "changing...";

        fetch(`/toggleFCM/${id}`, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ isActive: status }),
        })
          .then((res) => res.json())
          .then((data) => {
            if (data.success) {
              buttonElement.textContent = status ? "disabled" : "active";
              // Optionally you can also change style
              // buttonElement.classList.toggle("btn-danger", status);
            } else {
              alert(
                data.message || "Something went wrong while updating status."
              );
              buttonElement.textContent = originalText;
            }
          })
          .catch((err) => {
            console.error("Toggle error:", err);
            alert("Network error while toggling status.");
            buttonElement.textContent = originalText;
          });
      }

      function deleteFCM(id, buttonElement) {
        if (confirm("Are you sure you want to delete this tracking?")) {
          const originalText = buttonElement.textContent;
          buttonElement.textContent = "deleting...";
          buttonElement.disabled = true;

          fetch(`/deleteFCM/${id}`, {
            method: "DELETE",
          })
            .then((res) => res.json())
            .then((data) => {
              if (data.success) {
                // Optionally, you can remove the card or row from DOM without reload
                const card = buttonElement.closest(".card"); // Assuming button is in a .card
                if (card) card.remove();
              } else {
                alert(data.message || "Something went wrong while deleting.");
                buttonElement.textContent = originalText;
                buttonElement.disabled = false;
              }
            })
            .catch((err) => {
              console.error("Delete error:", err);
              alert("Network error while deleting tracking.");
              buttonElement.textContent = originalText;
              buttonElement.disabled = false;
            });
        }
      }

      
      window.onload = function () {
        document.getElementById("loader-text").textContent = "loaded";
        document.getElementById("loader").style.display = "none";
      };
    </script>
  </body>
</html>
