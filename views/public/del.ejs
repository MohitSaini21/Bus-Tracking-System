          left: 1320px;
        }
      }

      @-webkit-keyframes cloudy3 {
        0% {
          left: -100px;
        }
        100% {
          left: 1320px;
        }
      }

      #cloud4 {
        -webkit-transform: rotateY(180deg);
        transform: rotateY(180deg);
        opacity: 1;
        width: 100px;
        height: 100px;
        margin: -80px;
        position: absolute;
        background: url(http://images.clipartpanda.com/clouds-background-png-cloud-edition.png);
