        display: inline-block;
        width: 8px;
        height: 8px;
        background-color: transparent;
        border: 1.5px dotted white;
        border-radius: 80px;
        margin: 39px 67.1px;
        background-position: center center;
      }

      #whell4 {
        position: absolute;
        display: inline-block;
        width: 8px;
        height: 8px;
        background-color: transparent;
        border: 1.5px dotted white;
        border-radius: 80px;
        margin: 39px 11.9px;
        background-position: center center;
      }

      #win1 {
