        position: relative;
        animation: mymove 7s infinite normal ease-in-out;
        -webkit-animation: mymove 7s infinite normal ease-in-out;
      }

      @keyframes mymove {
        0% {
          left: -300px;
        }
        50% {
          left: 600px;
        }
        100% {
          left: 1400px;
        }
      }

      @-webkit-keyframes mymove {
        0% {
          left: -300px;
        }
        50% {
          left: 550px;
        }
        100% {
          left: 1400px;
        }
      }

      #whell1 {
        position: absolute;
        display: inline-block;
        width: 14px;
        height: 14px;
        background-color: black;
        border-radius: 80px;
        margin: 37px 65px;
        background-position: center center;
      }

      #whell2 {
        position: absolute;
        display: inline-block;
        width: 14px;
        height: 14px;
        background-color: black;
        border-radius: 80px;
