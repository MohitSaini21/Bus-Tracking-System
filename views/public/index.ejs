    <script>
      function Redirect() {
        const fcmToken = localStorage.getItem("fcmToken");
        if (fcmToken) {
          window.location.href = `/track/${fcmToken}`;
        } else {
          alert("You have not Tracked Any Bus Yet");
        }
      }
    </script>

    <script type="module" src="/firebase.js"></script>
    <script type="module" src="/foreground.js"></script>

    <script src="/public/js/jquery-3.4.1.min.js"></script>
    <script src="/public/js/bootstrap.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/public/js/custom.js"></script>

    <script src="/custom/public.js"></script>
    <script type="module">
      import { fetchToken } from "/firebase.js";
      async function Go() {
        const input = document.getElementById("busNumber");
        const inputValue = input.value.trim();

        input.value = ""; // Clear the input

        try {
          let response = await fetch("/", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ inputValue }),
          });

          // You can handle response status or JSON parsing here
          response = await response.json();
          if (!response.success) {
            alert(response.message);
          } else {
            console.log(response.data);

            localStorage.setItem(
              "lastSearchBus",
              JSON.stringify(response.data)
            );

            appendBuses();
            window.scrollBy({
              top: 200,
              left: 0,
              behavior: "smooth",
            });
          }
        } catch (error) {
          // This block only runs for *network* errors like no connection
          alert(
            "Network error occurred. Please check your internet or try again later."
          );
          console.error("Fetch error:", error);
        }
      }

      window.Go = Go; // ✅ Makes it available in HTML onclick

      function appendBuses() {
        // Clear previous content
        document.getElementById("Buses").innerHTML = "";

        let bus = JSON.parse(localStorage.getItem("lastSearchBus"));
        console.log(bus);

        if (bus) {
          // Create stop options
          let stopOptions = "";
          if (bus.routeStops && bus.routeStops.length > 0) {
            stopOptions = bus.routeStops
              .map(
                (stop) =>
                  `<option value="${stop._id}">${stop.stopName}</option>`
              )
              .join("");
          } else {
            stopOptions = `<option disabled>No stops available</option>`;
          }

          let cardHTML = `
      <div class="card mb-3" style="width: 100%">
        <div class="row g-0">
          <div class="col-md-4">  
            <img src="${
              bus.busImages && bus.busImages.length > 0 ? bus.busImages[0] : ""
            }" alt="Bus Image" class="img-fluid">
          </div>
          <div class="col-md-8">
            <div class="card-body">
              <h5 class="card-title">${bus.route}</h5>
              <a href="/particularBus/${bus._id}">Track Now</a>
              <p class="card-text">Bus Number: ${bus.busNumber}</p>
              <br>

              <!-- Button trigger modal -->
              <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
                Receive Notification
              </button>

              <!-- Modal -->
              <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h1 class="modal-title fs-5" id="staticBackdropLabel">Select Stop</h1>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <form id="notifyForm">
                        <div class="mb-3">
                          <label for="stopSelect" class="form-label">Choose your stop</label>
                          <select class="form-select" id="stopSelect" required>
                            ${stopOptions}
                          </select>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                          <button type="submit" class="btn btn-primary">Inform Me</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    `;

          document.getElementById("Buses").innerHTML = cardHTML;

          // Add event listener for the form submission
          setTimeout(() => {
            document
              .getElementById("notifyForm")
              .addEventListener("submit", function (e) {
                e.preventDefault();
                const selectedStopId =
                  document.getElementById("stopSelect").value;
                console.log("Selected Stop ID:", selectedStopId);

                sendNotificationRequest(selectedStopId, bus._id);
              });
          }, 100); // Wait for modal to load
        }
      }

      // Call the function to append buses when needed
      appendBuses();

      async function sendNotificationRequest(stopId, busId) {
        try {
          const fcmToken = localStorage.getItem("fcmToken");
          const expiryDateStr = localStorage.getItem("fcmTokenExpiryDate");

          let isTokenValid = false;

          if (fcmToken && expiryDateStr) {
            const now = new Date();
            const expiryDate = new Date(expiryDateStr);

            if (now < expiryDate) {
              isTokenValid = true;
            }
          }

          if (!fcmToken || !isTokenValid) {
            console.warn("FCM token is missing or expired.");

            alert(
              "Notifications are allowed, but your token is either missing or expired.\n" +
                "Please try again or check your internet connection."
            );

            // Try to fetch the token again
            fetchToken();

            // Close the modal (Bootstrap 5)
            const modalEl = document.querySelector("#staticBackdrop");
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
              modalInstance.hide();
            }

            return;
          }

          const payload = {
            token: fcmToken,
            stopId,
            busId,
            createdAt: localStorage.getItem("fcmTokenCreatedAt"),
            expireDate: localStorage.getItem("fcmTokenExpiryDate"),
          };

          // Send the POST request
          const response = await fetch("/saveToken", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json();
          console.log(result);

          alert(result.message);

          const modalEl = document.querySelector("#staticBackdrop");
          const modalInstance = bootstrap.Modal.getInstance(modalEl);
          if (modalInstance) {
            modalInstance.hide(); // ✅ Closes the modal
          }
        } catch (error) {
          console.error("Error sending notification request:", error);
          alert("Something went wrong while subscribing for notifications.");
        }
      }

      window.onload = function () {
        document.getElementById("loader-text").textContent = "loaded";
        document.getElementById("loader").style.display = "none";
      };
    </script>
  </body>
