    <script>
      async function Go() {
        const input = document.getElementById("routeInput");
        const inputValue = input.value.trim();

        input.value = ""; // Clear the input

        try {
          response = await fetch("/", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ route: inputValue }),
          });

          // You can handle response status or JSON parsing here
          response = await response.json();
          if (!response.success) {
            alert(response.message);
          } else {
            let topBuses = response.data.slice(0, 5); // Top 5 buses from response
            let existingBuses =
              JSON.parse(localStorage.getItem("lastSearchBuses")) || [];

            // Step 1: Create new/updated bus list
            topBuses.forEach((bus) => {
              let randomIndex = Math.floor(
                Math.random() * bus.busImages.length
              );
              let imageToStore =
                bus.busImages.length > 0
                  ? bus.busImages[randomIndex]
                  : "/public/images/busImage.jpg";

              // Check if bus already exists
              let existingIndex = existingBuses.findIndex(
                (b) => b.busNumber === bus.busNumber
              );

              let newBus = {
                busId: bus._id,
                busNumber: bus.busNumber,
                route: bus.route,
                busImage: imageToStore,
                lastSearch: Date.now(),
              };

              if (existingIndex !== -1) {
                // Bus exists: update lastSearch and move to latest
                existingBuses[existingIndex] = newBus;
              } else {
                // New bus: push to array
                existingBuses.push(newBus);
              }
            });

            // Step 2: Sort by lastSearch (latest first)
            existingBuses.sort((a, b) => b.lastSearch - a.lastSearch);

            // Step 3: Limit to top 5
            let limitedBuses = existingBuses.slice(0, 5);

            // Step 4: Store in localStorage
            localStorage.setItem(
              "lastSearchBuses",
              JSON.stringify(limitedBuses)
            );

            // Optional: Log to check
            console.log("Updated Buses:", limitedBuses);

            // Step 5: Show in UI
            appendBuses();
            window.scrollBy({
              top: 200,
              left: 0,
              behavior: "smooth",
            });
          }
        } catch (error) {
          // This block only runs for *network* errors like no connection
          alert(
            "Network error occurred. Please check your internet or try again later."
          );
          console.error("Fetch error:", error);
        }
      }

      function appendBuses() {
        // Get the stored buses from localStorage
        document.getElementById("Buses").innerHTML = "";
        let storedBuses = JSON.parse(localStorage.getItem("lastSearchBuses"));

        // Check if there are any stored buses
        if (storedBuses && storedBuses.length > 0) {
          // Iterate through each stored bus and create a card for it
          storedBuses.forEach((bus) => {
            // Create the card HTML structure
            let cardHTML = `
           <div class="card mb-3" style="width: 100%">
             <div class="row g-0">
               <div class="col-md-4">
                 <img src="${
                   bus.busImage
                 }" class="img-fluid rounded-start" alt="Bus Image" />
               </div>
               <div class="col-md-8">
                 <div class="card-body">
                   <h5 class="card-title">${bus.route}</h5>
                   <p class="card-text">Bus Number: ${bus.busNumber}</p>
      <p class="card-text">Last Search: ${new Date(
        bus.lastSearch
      ).toLocaleString()}</p>


      <a href="/particularBus/${bus.busId}">Track Now</a>
      <br>
      <div class="form-check  text-warning-emphasis">
  <input class="form-check-input  text-warning-emphasis" type="radio" name="radioDefault" id="radioDefault2">
  <label class="form-check-label  text-warning-emphasis" for="radioDefault2">
    Notify About ${bus.busNumber}
    
  </label>
</div>





                 </div>
               </div>
             </div>
           </div>
         `;

            // Append the card to the DOM (e.g., to a container with id 'busContainer')
            document.getElementById("Buses").innerHTML += cardHTML;
          });
        } else {
          console.log("No buses found in localStorage.");
        }
      }

      // Call the function to append buses when needed
      appendBuses();
    </script>

